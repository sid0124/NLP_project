# =============================================================================
# Environment variables — copy to `.env` and edit. NEVER commit `.env`.
# =============================================================================
# Values here override the corresponding entries in configs/*.yaml.
# `.env` is gitignored; this example file is committed as documentation.
# =============================================================================

# -----------------------------------------------------------------------------
# OpenAlex ingestion
# -----------------------------------------------------------------------------
# OpenAlex is free and needs no API key, but asks callers to identify
# themselves by email. Doing so places requests in the faster, more reliable
# "polite pool". Strongly recommended before any real fetch.
OPENALEX_MAILTO=your.email@example.com

# -----------------------------------------------------------------------------
# Runtime overrides (optional — omit to use configs/config.yaml)
# -----------------------------------------------------------------------------
# Global random seed for reproducible splits and model fits.
# ARIS_SEED=42

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
# ARIS_LOG_LEVEL=INFO

# Override the data root (useful when data lives on another drive).
# ARIS_DATA_DIR=data

# -----------------------------------------------------------------------------
# Reserved for later milestones — no effect in Milestone 1.
# Listed so the deployment surface is visible early; keep real secrets out.
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/aris
# REDIS_URL=redis://localhost:6379/0
# MLFLOW_TRACKING_URI=http://localhost:5000
# API_SECRET_KEY=change-me-in-production
